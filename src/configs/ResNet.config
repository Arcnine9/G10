# Output folder
output_folder           ../results/ResNet152/Ascend
is_simulation           1

# Model type
is_resnet               1
is_inception            0
is_senet                0
is_transformer          0

# Input parameters
batch_size              1536
input_H                 299
input_W                 299
num_iteration           2
num_threads             128

# Prefetch / UVM
is_UVM                  1
use_prefetch            1

# Files
nn_model_input_file     ../data/model_info_ResNet152.txt
orig_kernel_time_file   ../data/output.txt
pf_kernel_time_file     ../data/output.txt
input_pf_kernel_time_file ../data/output.txt
workspace_size_file       ../results/ResNet152/cudnn1536Workspace.txt
stat_output_file        sim_result

# Memory management policy
eviction_policy         LRU
migration_policy        OURS

# System parameters
system_latency_us       45
CPU_PCIe_bandwidth_GBps 15.754
CPU_memory_line_GB      128
GPU_memory_size_GB      40
GPU_frequency_GHz       1.2
GPU_PCIe_bandwidth_GBps 15.754
GPU_malloc_uspB         0.000000814
GPU_free_uspB           0
SSD_PCIe_bandwidth_GBps 3.2
SSD_read_latency_us     12
SSD_write_latency_us    16
SSD_latency_us          20
PCIe_latency_us         5
PCIe_batch_size_page    50

# Simulation tuning
delta_parameter         0.5
